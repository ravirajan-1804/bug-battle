    (bind me (Player|GetOwningPlayerPawn))
    (bind colors (Variables|Default|GetRacerColors))
    (bind cars (Actor|GetAllActorsOfClass "/Script/ChaosVehicles.WheeledVehiclePawn"))
    (for i (range (Utilities|Array|Length cars))
      (bind car (Utilities|Array|Get(acopy) cars i))
      (if (!= car me)
        (bind ps (Class|Pawn|GetPlayerState car))
        (Utilities|IsValid ps
          (:"Is Valid"
            (bind locA (Transformation|GetActorLocation :self car))
            (bind dxrA (* (- (.x locA) (.x wc)) sc))
            (bind dyrA (* (- (.y locA) (.y wc)) sc))
            (bind sxrA (+ (.x mc) (- (* dyrA ux) (* dxrA uy))))
            (bind syrA (- (.y mc) (+ (* dxrA ux) (* dyrA uy))))
            (bind rcA (Utilities|Array|Get(acopy) colors (Math|Integer|%(Integer) (Class|PlayerState|GetPlayerId ps) 7)))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA 5.000) (+ syrA 0.000)) (Math|Vector2D|MakeVector2D (+ sxrA 2.500) (+ syrA 4.330)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA 2.500) (+ syrA 4.330)) (Math|Vector2D|MakeVector2D (+ sxrA -2.500) (+ syrA 4.330)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA -2.500) (+ syrA 4.330)) (Math|Vector2D|MakeVector2D (+ sxrA -5.000) (+ syrA 0.000)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA -5.000) (+ syrA 0.000)) (Math|Vector2D|MakeVector2D (+ sxrA -2.500) (+ syrA -4.330)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA -2.500) (+ syrA -4.330)) (Math|Vector2D|MakeVector2D (+ sxrA 2.500) (+ syrA -4.330)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA 2.500) (+ syrA -4.330)) (Math|Vector2D|MakeVector2D (+ sxrA 5.000) (+ syrA -0.000)) "(R=0.1,G=0.055,B=0.03,A=1)" true (* pxs 10))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA 3.800) (+ syrA 0.000)) (Math|Vector2D|MakeVector2D (+ sxrA 1.900) (+ syrA 3.291)) "(R=1,G=1,B=1,A=1)" true (* pxs 7.6))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA 1.900) (+ syrA 3.291)) (Math|Vector2D|MakeVector2D (+ sxrA -1.900) (+ syrA 3.291)) "(R=1,G=1,B=1,A=1)" true (* pxs 7.6))
            (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ sxrA -1.900) (+ syrA 3.291)) (Math|Vector2D|MakeVector2D (+ sxrA -3.800) (+ syrA 0.000)) "(R=1,G=1,B=1,A=1)" true (* pxs 7.6))
