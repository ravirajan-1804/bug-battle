(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (bind ls (UserInterface|Geometry|GetLocalSize MyGeometry))
  (Variables|Default|SetScreenSize ls)
  (Variables|Default|SetPixelScale (/ (.x (UserInterface|Geometry|GetAbsoluteSize MyGeometry)) (Math|Float|Max(Float) (.x ls) 1.0)))
  (Variables|Default|SetHudAlpha 0.0)
  (Variables|Default|SetShowB false)
  (if (and (Variables|Default|GetReady) (Variables|Default|GetAttached))
    (bind mgr (Variables|Default|GetMgr))
    (bind st (Class|BPRGRaceManager|GetIntroStart mgr))
    (if (> st 0.0)
      (Variables|Default|SetHudAlpha (Math|Float|Clamp(Float) (/ (- (- (GameState|GetServerWorldTimeSeconds (Game|GetGameState)) st) 6.15) 0.50) 0.0 1.0)))
    (Variables|Default|SetShowB (> (Variables|Default|GetHudAlpha) 0.01))
    (Widget|SetRenderOpacity :self self :InOpacity (Variables|Default|GetHudAlpha))
    (Widget|SetRenderOpacity :self (Variables|Default|GetBoardImg) :InOpacity (Variables|Default|GetHudAlpha))
    (Widget|Transform|SetRenderTranslation (Variables|Default|GetBoardImg) (Math|Vector2D|MakeVector2D 40.0 40.0))
    (bind cars (Class|BPRGRaceManager|GetCars mgr))
    (bind nc (Utilities|Array|Length cars))
    (bind nb (Utilities|Array|Length (Class|BPRGRaceManager|GetBots mgr)))
    (bind npts (Utilities|Array|Length (Class|BPRGRaceManager|GetTrackPts mgr)))
    (bind now (Utilities|Time|GetGameTimeinSeconds))
    (Variables|Default|SetRows (Math|Integer|Min(Integer) nc 8))
    (Variables|Default|SetMeSlot -1)
    (bind me (Player|GetOwningPlayerPawn))
    (for i (range nc)
      (if (== (Utilities|Array|Get(acopy) cars i) me)
        (Variables|Default|SetMeSlot i)))
    (bind ms (Variables|Default|GetMeSlot))
    (bind nl (Class|BPRGRaceManager|GetNumLaps mgr))
    (Utilities|Array|Resize (Variables|Default|GetPrevRank) nc)
    (Utilities|Array|Resize (Variables|Default|GetChgT) nc)
    (Utilities|Array|Resize (Variables|Default|GetChgDir) nc)
    (for s (range nc)
      (bind rk0 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetRank mgr) s))
      (bind pr0 (Utilities|Array|Get(acopy) (Variables|Default|GetPrevRank) s))
      (if (and (and (> pr0 0) (!= rk0 pr0)) (> (Class|BPRGRaceManager|GetRaceT mgr) 1.0))
        (Utilities|Array|SetArrayElem (Variables|Default|GetChgT) s now true)
        (if (< rk0 pr0)
          (Utilities|Array|SetArrayElem (Variables|Default|GetChgDir) s 1 true)
          (else
            (Utilities|Array|SetArrayElem (Variables|Default|GetChgDir) s -1 true))))
      (Utilities|Array|SetArrayElem (Variables|Default|GetPrevRank) s rk0 true))
    (Utilities|Array|Clear (Variables|Default|GetRowName))
    (Utilities|Array|Clear (Variables|Default|GetRowRight))
    (Utilities|Array|Clear (Variables|Default|GetRowMe))
    (Utilities|Array|Clear (Variables|Default|GetRowUp))
    (Utilities|Array|Clear (Variables|Default|GetRowDn))
    (for r (range (Variables|Default|GetRows))
      (bind s (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) r))
      (if (< s nb)
        (Utilities|Array|Add (Variables|Default|GetRowName) (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetBotNames mgr) s))
        (elif (== s ms)
          (Utilities|Array|Add (Variables|Default|GetRowName) "YOU")
          (else
            (Utilities|Array|Add (Variables|Default|GetRowName) (Utilities|String|Append "PLAYER " (Utilities|String|ToString(Integer) (+ (- s nb) 1)))))))
      (bind ft (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetFinishT mgr) s))
      (if (> ft 0.0)
        (Utilities|Array|Add (Variables|Default|GetRowRight) (Utilities|String|Append (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Truncate (/ ft 60.0))) ":") (Utilities|String|ToString(Text) (Utilities|Text|ToText(Float) (- ft (* (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate (/ ft 60.0))) 60.0)) :bUseGrouping false :MinimumIntegralDigits 2 :MinimumFractionalDigits 2 :MaximumFractionalDigits 2))))
        (else
          (Utilities|Array|Add (Variables|Default|GetRowRight) (Utilities|String|Append "LAP " (Utilities|String|ToString(Integer) (Math|Integer|Clamp(Integer) (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetLaps mgr) s) 1 nl))))))
      (if (== s ms)
        (Utilities|Array|Add (Variables|Default|GetRowMe) 1.0)
        (else
          (Utilities|Array|Add (Variables|Default|GetRowMe) 0.0)))
      (bind ca (Math|Float|Clamp(Float) (- 1.0 (/ (- now (Utilities|Array|Get(acopy) (Variables|Default|GetChgT) s)) 2.0)) 0.0 1.0))
      (bind cd (Utilities|Array|Get(acopy) (Variables|Default|GetChgDir) s))
      (if (> cd 0)
        (Utilities|Array|Add (Variables|Default|GetRowUp) ca)
        (Utilities|Array|Add (Variables|Default|GetRowDn) 0.0)
        (elif (< cd 0)
          (Utilities|Array|Add (Variables|Default|GetRowUp) 0.0)
          (Utilities|Array|Add (Variables|Default|GetRowDn) ca)
          (else
            (Utilities|Array|Add (Variables|Default|GetRowUp) 0.0)
            (Utilities|Array|Add (Variables|Default|GetRowDn) 0.0)))))
    (if (< 0 (Variables|Default|GetRows))
      (bind sk0 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 0))
      (if (< sk0 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C0") (Math|Conversions|ToFloat(Integer) sk0))
        (elif (== sk0 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C0") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C0") 6.0)))))
    (if (< 1 (Variables|Default|GetRows))
      (bind sk1 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 1))
      (if (< sk1 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C1") (Math|Conversions|ToFloat(Integer) sk1))
        (elif (== sk1 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C1") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C1") 6.0)))))
    (if (< 2 (Variables|Default|GetRows))
      (bind sk2 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 2))
      (if (< sk2 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C2") (Math|Conversions|ToFloat(Integer) sk2))
        (elif (== sk2 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C2") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C2") 6.0)))))
    (if (< 3 (Variables|Default|GetRows))
      (bind sk3 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 3))
      (if (< sk3 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C3") (Math|Conversions|ToFloat(Integer) sk3))
        (elif (== sk3 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C3") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C3") 6.0)))))
    (if (< 4 (Variables|Default|GetRows))
      (bind sk4 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 4))
      (if (< sk4 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C4") (Math|Conversions|ToFloat(Integer) sk4))
        (elif (== sk4 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C4") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C4") 6.0)))))
    (if (< 5 (Variables|Default|GetRows))
      (bind sk5 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 5))
      (if (< sk5 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C5") (Math|Conversions|ToFloat(Integer) sk5))
        (elif (== sk5 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C5") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C5") 6.0)))))
    (if (< 6 (Variables|Default|GetRows))
      (bind sk6 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 6))
      (if (< sk6 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C6") (Math|Conversions|ToFloat(Integer) sk6))
        (elif (== sk6 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C6") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C6") 6.0)))))
    (if (< 7 (Variables|Default|GetRows))
      (bind sk7 (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetOrder mgr) 7))
      (if (< sk7 nb)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C7") (Math|Conversions|ToFloat(Integer) sk7))
        (elif (== sk7 ms)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C7") 7.0)
          (else
            (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "C7") 6.0)))))
    (Variables|Default|SetMeFinished false)
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Final") 0.0)
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Prog") 0.0)
    (if (>= ms 0)
      (bind rk (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetRank mgr) ms))
      (bind ml (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetLaps mgr) ms))
      (bind mft (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetFinishT mgr) ms))
      (if (and (== ml nl) (<= mft 0.0))
        (Variables|Default|SetHeadL "FINAL LAP!")
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Final") 1.0)
        (else
          (Variables|Default|SetHeadL (Utilities|String|Append "LAP " (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Integer|Clamp(Integer) ml 1 nl)) (Utilities|String|Append "/" (Utilities|String|ToString(Integer) nl)))))))
      (Variables|Default|SetHeadR (Utilities|String|Append "P" (Utilities|String|Append (Utilities|String|ToString(Integer) rk) (Utilities|String|Append "/" (Utilities|String|ToString(Integer) nc)))))
      (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Hi") (Math|Conversions|ToFloat(Integer) (- rk 1)))
      (if (> mft 0.0)
        (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Prog") 1.0)
        (elif (>= ml 1)
          (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Prog") (Math|Float|Clamp(Float) (/ (Math|Conversions|ToFloat(Integer) (+ (* (- ml 1) npts) (Utilities|Array|Get(acopy) (Class|BPRGRaceManager|GetLastRel mgr) ms))) (Math|Conversions|ToFloat(Integer) (Math|Integer|Max(Integer) (* nl npts) 1))) 0.0 1.0))))
      (if (> mft 0.0)
        (Variables|Default|SetMeFinished true)
        (if (== rk 1)
          (Variables|Default|SetBanner2 "1ST PLACE")
          (elif (== rk 2)
            (Variables|Default|SetBanner2 "2ND PLACE")
            (elif (== rk 3)
              (Variables|Default|SetBanner2 "3RD PLACE")
              (else
                (Variables|Default|SetBanner2 (Utilities|String|Append (Utilities|String|ToString(Integer) rk) "TH PLACE"))))))
        (Variables|Default|SetBanner2 (Utilities|String|Append (Variables|Default|GetBanner2) (Utilities|String|Append "   " (Utilities|String|Append (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Truncate (/ mft 60.0))) ":") (Utilities|String|ToString(Text) (Utilities|Text|ToText(Float) (- mft (* (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate (/ mft 60.0))) 60.0)) :bUseGrouping false :MinimumIntegralDigits 2 :MinimumFractionalDigits 2 :MaximumFractionalDigits 2))))))))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetBoardMID) (Utilities|Name|MakeLiteralName "Rows") (Math|Conversions|ToFloat(Integer) (Variables|Default|GetRows))))
  (if (not (Variables|Default|GetReady))
    (bind m (Utilities|Casting|CastToBP_RG_RaceManager (Actor|GetActorOfClass "/Game/RacingGame/Gameplay/BP_RG_RaceManager.BP_RG_RaceManager_C"))
      (:then
        (Variables|Default|SetMgr m)
        (Variables|Default|SetReady true))
      (:CastFailed))))
