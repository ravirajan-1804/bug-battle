(fn AttachToHud (HudWidget)
  (if (not (Utilities|String|NotEqual,CaseInsenstive(String) (Game|GetCurrentLevelName true) "Lvl_GardenGrandPrix"))
    (CallFunction|ClimbtoRoot :Child HudWidget)
    (bind overlay (Utilities|Casting|CastToOverlay (Variables|Default|GetHostRoot))
      (:then
        (bind mapimg (Game|ConstructObjectfromClass :Class "/Script/UMG.Image"))
        (Class|Image|SetBrush :self mapimg :Brush (Widget|Brush|MakeBrushfromMaterial "/Game/RacingGame/UI/M_RG_HUD_Panel.M_RG_HUD_Panel" 352 272))
        (Class|Image|SetColorandOpacity :self mapimg :ColorAndOpacity "(R=1,G=1,B=1,A=1)")
        (Widget|SetVisibility mapimg "HitTestInvisible")
        (bind mapimgslot (Widget|AddChildtoOverlay overlay mapimg))
        (Layout|OverlaySlot|SetHorizontalAlignment mapimgslot "HAlign_Left")
        (Layout|OverlaySlot|SetVerticalAlignment mapimgslot "VAlign_Top")
        (Variables|Default|SetMapImg mapimg)
        (bind gaugeimg (Game|ConstructObjectfromClass :Class "/Script/UMG.Image"))
        (Class|Image|SetBrush :self gaugeimg :Brush (Widget|Brush|MakeBrushfromMaterial "/Game/RacingGame/UI/M_RG_HUD_Gauge.M_RG_HUD_Gauge" 210 210))
        (Class|Image|SetColorandOpacity :self gaugeimg :ColorAndOpacity "(R=0.5,G=0.5,B=1,A=1)")
        (Widget|SetVisibility gaugeimg "Collapsed")
        (bind gaugeimgslot (Widget|AddChildtoOverlay overlay gaugeimg))
        (Layout|OverlaySlot|SetHorizontalAlignment gaugeimgslot "HAlign_Left")
        (Layout|OverlaySlot|SetVerticalAlignment gaugeimgslot "VAlign_Top")
        (Variables|Default|SetGaugeImg gaugeimg)
        (bind badgeimg (Game|ConstructObjectfromClass :Class "/Script/UMG.Image"))
        (Class|Image|SetBrush :self badgeimg :Brush (Widget|Brush|MakeBrushfromMaterial "/Game/RacingGame/UI/M_RG_HUD_Badge.M_RG_HUD_Badge" 92 92))
        (Class|Image|SetColorandOpacity :self badgeimg :ColorAndOpacity "(R=1,G=0.05,B=0.35,A=0.5)")
        (Widget|SetVisibility badgeimg "Collapsed")
        (bind badgeimgslot (Widget|AddChildtoOverlay overlay badgeimg))
        (Layout|OverlaySlot|SetHorizontalAlignment badgeimgslot "HAlign_Left")
        (Layout|OverlaySlot|SetVerticalAlignment badgeimgslot "VAlign_Top")
        (Variables|Default|SetBadgeImg badgeimg)
        (bind oslot (Widget|AddChildtoOverlay overlay self))
        (Layout|OverlaySlot|SetHorizontalAlignment oslot "HAlign_Fill")
        (Layout|OverlaySlot|SetVerticalAlignment oslot "VAlign_Fill")
        (Variables|Default|SetMapReady true)
        (bind sbox (Widget|GetParent HudWidget))
        (bind hb (Widget|GetParent (Widget|GetParent sbox)))
        (Variables|Default|SetSpeedBox sbox)
        (Variables|Default|SetSpeedRow hb)
        (for i (range (Widget|Panel|GetChildrenCount hb))
          (bind pw (Utilities|Casting|CastToPanelWidget (Widget|Panel|GetChildAt hb i))
            (:then
              (bind gt (Utilities|Casting|CastToTextBlock (Widget|Panel|GetChildAt pw 0))
                (:then
                  (Variables|Default|SetGearBox pw)
                  (Variables|Default|SetGearText gt))
                (:CastFailed)))
            (:CastFailed)))
        (bind st (Utilities|Casting|CastToTextBlock HudWidget)
          (:then
            (Variables|Default|SetSpeedText st)
            (bind ut (Utilities|Casting|CastToTextBlock (Widget|Panel|GetChildAt sbox 1))
              (:then
                (Variables|Default|SetUnitText ut)
                (Utilities|IsValid (Variables|Default|GetGearText)
                  (:"Is Valid"
                    (Widget|SetRenderOpacity :self sbox :InOpacity 0.004)
                    (Widget|SetRenderOpacity :self (Variables|Default|GetGearBox) :InOpacity 0.004)
                    (Widget|SetVisibility (Variables|Default|GetGaugeImg) "HitTestInvisible")
                    (Widget|SetVisibility (Variables|Default|GetBadgeImg) "HitTestInvisible")
                    (Variables|Default|SetSpeedoReady true))
                  (:"Is Not Valid")))
              (:CastFailed)))
          (:CastFailed)))
      (:CastFailed
        (bind canvas (Utilities|Casting|CastToCanvasPanel (Variables|Default|GetHostRoot))
          (:then
            (bind slot (CanvasPanel|AddChildtoCanvas canvas self))
            (Layout|CanvasSlot|SetAnchors slot "(Minimum=(X=0,Y=0),Maximum=(X=1,Y=1))")
            (Layout|CanvasSlot|SetOffsets slot "(Left=0,Top=0,Right=0,Bottom=0)"))
          (:CastFailed
            (UserInterface|Viewport|AddtoPlayerScreen self 5)))))))
