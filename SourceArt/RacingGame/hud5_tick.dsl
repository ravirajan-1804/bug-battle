(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (Variables|Default|SetDt InDeltaTime)
  (bind hs (UserInterface|Geometry|GetLocalSize MyGeometry))
  (Variables|Default|SetHostSize hs)
  (Variables|Default|SetPixelScale (/ (.x (UserInterface|Geometry|GetAbsoluteSize MyGeometry)) (Math|Float|Max(Float) (.x hs) 1.0)))
  (Variables|Default|SetMapC (Math|Vector2D|MakeVector2D 208.0 (- (.y hs) 208)))
  (Variables|Default|SetSpeedoO (Math|Vector2D|MakeVector2D (- (.x hs) 500) (- (.y hs) 332)))
  (CallFunction|ReadCar)
  (CallFunction|UpdateMap)
  (Variables|Default|SetHudAlpha 0.0)
  (if (Variables|Default|GetMapInit)
    (bind st (Class|BPRGRaceManager|GetIntroStart (Variables|Default|GetRaceMgr)))
    (if (> st 0.0)
      (Variables|Default|SetHudAlpha (Math|Float|Clamp(Float) (/ (- (- (GameState|GetServerWorldTimeSeconds (Game|GetGameState)) st) 6.15) 0.50) 0.0 1.0))))
  (Widget|SetRenderOpacity :self self :InOpacity (Variables|Default|GetHudAlpha))
  (Variables|Default|SetShowSpeedo (and (Variables|Default|GetHaveCar) (> (Variables|Default|GetHudAlpha) 0.01)))
  (Variables|Default|SetShowMap (and (Variables|Default|GetMapInit) (> (Variables|Default|GetHudAlpha) 0.01)))
  (if (Variables|Default|GetMapReady)
    (bind mc (Variables|Default|GetMapC))
    (Widget|Transform|SetRenderTranslation (Variables|Default|GetMapImg) (Math|Vector2D|MakeVector2D (- (.x mc) 168) (- (.y mc) 168)))
    (Widget|Transform|SetRenderTranslation (Variables|Default|GetGaugeImg) (Variables|Default|GetSpeedoO))
    (Widget|SetRenderOpacity :self (Variables|Default|GetMapImg) :InOpacity (Variables|Default|GetHudAlpha))
    (Widget|SetRenderOpacity :self (Variables|Default|GetGaugeImg) :InOpacity (Variables|Default|GetHudAlpha))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetSpeedoMID) (Utilities|Name|MakeLiteralName "Speed") (Math|Float|Clamp(Float) (/ (Variables|Default|GetShownSpeed) 240.0) 0.0 1.0))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetSpeedoMID) (Utilities|Name|MakeLiteralName "Rpm") (Variables|Default|GetRpmFrac))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetSpeedoMID) (Utilities|Name|MakeLiteralName "Throttle") (Variables|Default|GetThrottle))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetSpeedoMID) (Utilities|Name|MakeLiteralName "Boost") (Variables|Default|GetBoost))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetSpeedoMID) (Utilities|Name|MakeLiteralName "Pop") (Variables|Default|GetPop))
    (bind u (Variables|Default|GetMapU))
    (Rendering|Material|InitializeScalarParameterandGetIndex (Variables|Default|GetRadarMID) (Utilities|Name|MakeLiteralName "North") (Math|Trig|Atan2(Radians) (- 0.0 (.x u)) (- 0.0 (.y u)))))
  (if (not (Variables|Default|GetMapInit))
    (bind rm (Utilities|Casting|CastToBP_RG_RaceManager (Actor|GetActorOfClass "/Game/RacingGame/Gameplay/BP_RG_RaceManager.BP_RG_RaceManager_C"))
      (:then
        (Variables|Default|SetRaceMgr rm)
        (CallFunction|InitMap))
      (:CastFailed))))
