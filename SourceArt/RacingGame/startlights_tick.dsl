(event UserInterface|EventConstruct
  (Variables|Default|SetReleased false)
  (Variables|Default|SetStage 0)
  (Variables|Default|SetShowLights true)
  (Variables|Default|SetRacing false)
  (Variables|Default|SetLetterbox 1.0)
  (Variables|Default|SetLamps (Actor|GetAllActorswithTag "RG_StartLight"))
  (Variables|Default|SetManager (Utilities|Casting|CastToBP_RG_RaceManager (Actor|GetActorOfClass "/Game/RacingGame/Gameplay/BP_RG_RaceManager.BP_RG_RaceManager_C")))
  ; local cinematic camera: every client spawns its own, nothing to replicate
  (bind camA (Game|SpawnActorfromClass :Class "/Script/Engine.CameraActor"
    :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -4150 :Y 11930 :Z 28)) :CollisionHandlingOverride "AlwaysSpawn"))
  (bind camC (Utilities|Casting|CastToCameraActor camA))
  (Variables|Default|SetIntroCam camC)
  (bind ccompC (Class|CameraActor|GetCameraComponent camC))
  (Camera|SetFieldOfView :self ccompC :InFieldOfView 72)
  (Game|Player|SetViewTargetwithBlend :self (Widget|GetOwningPlayer) :NewViewTarget camC :BlendTime 0.0))

(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (bind local (UserInterface|Geometry|GetLocalSize MyGeometry))
  (Variables|Default|SetScreenSize local)
  (Variables|Default|SetPixelScale (/ (.x (UserInterface|Geometry|GetAbsoluteSize MyGeometry)) (Math|Float|Max(Float) (.x local) 1.0)))
  (Variables|Default|SetOrigin (Math|Vector2D|MakeVector2D (* (.x local) 0.5) 130.0))
  ; intro clock shared by all players: server time since the replicated IntroStart (-1 until it arrives)
  (bind st (Class|BPRGRaceManager|GetIntroStart (Variables|Default|GetManager)))
  (bind now (GameState|GetServerWorldTimeSeconds (Game|GetGameState)))
  (bind t (select (> st 0.0) (- now st) -1.0))
  (Variables|Default|SetT t)
  (bind pc (Widget|GetOwningPlayer))
  (bind cam (Variables|Default|GetIntroCam))
  (bind ccomp (Class|CameraActor|GetCameraComponent cam))
  (if (and (< t 5.55) (!= (Pawn|GetViewTarget pc) cam))
    (Game|Player|SetViewTargetwithBlend :self pc :NewViewTarget cam :BlendTime 0.0))
  (if (< t 0.0)
    (Variables|Default|SetLamp0 "(R=0.07,G=0.07,B=0.08,A=1)")
    (Variables|Default|SetGlow0 "(R=0.03,G=0.03,B=0.035,A=1)")
    (Variables|Default|SetLamp1 "(R=0.07,G=0.07,B=0.08,A=1)")
    (Variables|Default|SetGlow1 "(R=0.03,G=0.03,B=0.035,A=1)")
    (Variables|Default|SetLamp2 "(R=0.07,G=0.07,B=0.08,A=1)")
    (Variables|Default|SetGlow2 "(R=0.03,G=0.03,B=0.035,A=1)")
    (Variables|Default|SetLabel "")
    (Variables|Default|SetLabelColor "(R=1,G=0.04,B=0.02,A=1)")
    (Variables|Default|SetLabelX 0)
    (for lampP (Variables|Default|GetLamps)
      (bind lcP (Actor|GetComponentbyClass :self lampP :ComponentClass "/Script/Engine.PointLightComponent"))
      (Rendering|Components|Light|SetLightColor :self lcP :NewLightColor "(R=0.12,G=0.02,B=0.01,A=1)" :bSRGB true))
    (bind alP (Math|Float|Clamp(Float) (/ (- t 0) 1.6) 0.0 1.0))
    (bind smP (* (* alP alP) (- 3.0 (* 2.0 alP))))
    (bind cpP (Math|Vector|Lerp(Vector) (Math|Vector|MakeVector :X -4150 :Y 11930 :Z 28) (Math|Vector|MakeVector :X -4700 :Y 11990 :Z 34) smP))
    (Transformation|SetActorLocationAndRotation :self cam :NewLocation cpP :NewRotation (Math|Rotator|FindLookatRotation cpP (Math|Vector|MakeVector :X -5900 :Y 12700 :Z 110)) :bSweep false :bTeleport true)
    (bind pawnP (Player|GetOwningPlayerPawn))
    (Utilities|IsValid pawnP
      (:"Is Valid"
        (Input|DisableInput :self pawnP :PlayerController (Widget|GetOwningPlayer))
        (bind mvP (Actor|GetComponentbyClass :self pawnP :ComponentClass "/Script/ChaosVehicles.ChaosVehicleMovementComponent"))
        (Game|Components|ChaosVehicleMovement|SetThrottleInput :self mvP :Throttle 0.0)
        (Game|Components|ChaosVehicleMovement|SetHandbrakeInput :self mvP :bNewHandbrake true))
      (:"Is Not Valid"))
    (elif (< t 1.6)
      (Variables|Default|SetLamp0 "(R=1,G=0.04,B=0.02,A=1)")
      (Variables|Default|SetGlow0 "(R=0.35,G=0.014,B=0.007,A=1)")
      (Variables|Default|SetLamp1 "(R=0.07,G=0.07,B=0.08,A=1)")
      (Variables|Default|SetGlow1 "(R=0.03,G=0.03,B=0.035,A=1)")
      (Variables|Default|SetLamp2 "(R=0.07,G=0.07,B=0.08,A=1)")
      (Variables|Default|SetGlow2 "(R=0.03,G=0.03,B=0.035,A=1)")
      (Variables|Default|SetLabel "3")
      (Variables|Default|SetLabelColor "(R=1,G=0.04,B=0.02,A=1)")
      (Variables|Default|SetLabelX -19)
      (for lamp3 (Variables|Default|GetLamps)
        (bind lc3 (Actor|GetComponentbyClass :self lamp3 :ComponentClass "/Script/Engine.PointLightComponent"))
        (Rendering|Components|Light|SetLightColor :self lc3 :NewLightColor "(R=1,G=0.05,B=0.02,A=1)" :bSRGB true))
      (if (< (Variables|Default|GetStage) 1)
        (Variables|Default|SetStage 1)
        (Camera|SetFieldOfView :self ccomp :InFieldOfView 72)
        (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_CountHit.SW_RG_CountHit" :VolumeMultiplier 1)
        (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_EngineIdle.SW_RG_EngineIdle" :VolumeMultiplier 0.55)
      )
      (bind al3 (Math|Float|Clamp(Float) (/ (- t 0) 1.6) 0.0 1.0))
      (bind sm3 (* (* al3 al3) (- 3.0 (* 2.0 al3))))
      (bind cp3 (Math|Vector|Lerp(Vector) (Math|Vector|MakeVector :X -4150 :Y 11930 :Z 28) (Math|Vector|MakeVector :X -4700 :Y 11990 :Z 34) sm3))
      (Transformation|SetActorLocationAndRotation :self cam :NewLocation cp3 :NewRotation (Math|Rotator|FindLookatRotation cp3 (Math|Vector|MakeVector :X -5900 :Y 12700 :Z 110)) :bSweep false :bTeleport true)
      (bind pawn3 (Player|GetOwningPlayerPawn))
      (Utilities|IsValid pawn3
        (:"Is Valid"
          (Input|DisableInput :self pawn3 :PlayerController (Widget|GetOwningPlayer))
          (bind mv3 (Actor|GetComponentbyClass :self pawn3 :ComponentClass "/Script/ChaosVehicles.ChaosVehicleMovementComponent"))
          (Game|Components|ChaosVehicleMovement|SetThrottleInput :self mv3 :Throttle 0.0)
          (Game|Components|ChaosVehicleMovement|SetHandbrakeInput :self mv3 :bNewHandbrake true))
        (:"Is Not Valid"))
      (elif (< t 3.2)
        (Variables|Default|SetLamp0 "(R=0.07,G=0.07,B=0.08,A=1)")
        (Variables|Default|SetGlow0 "(R=0.03,G=0.03,B=0.035,A=1)")
        (Variables|Default|SetLamp1 "(R=1,G=0.72,B=0,A=1)")
        (Variables|Default|SetGlow1 "(R=0.35,G=0.252,B=0,A=1)")
        (Variables|Default|SetLamp2 "(R=0.07,G=0.07,B=0.08,A=1)")
        (Variables|Default|SetGlow2 "(R=0.03,G=0.03,B=0.035,A=1)")
        (Variables|Default|SetLabel "2")
        (Variables|Default|SetLabelColor "(R=1,G=0.72,B=0,A=1)")
        (Variables|Default|SetLabelX -19)
        (for lamp2 (Variables|Default|GetLamps)
          (bind lc2 (Actor|GetComponentbyClass :self lamp2 :ComponentClass "/Script/Engine.PointLightComponent"))
          (Rendering|Components|Light|SetLightColor :self lc2 :NewLightColor "(R=1,G=0.65,B=0,A=1)" :bSRGB true))
        (if (< (Variables|Default|GetStage) 2)
          (Variables|Default|SetStage 2)
          (Camera|SetFieldOfView :self ccomp :InFieldOfView 66)
          (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_CountHit.SW_RG_CountHit" :VolumeMultiplier 1)
        )
        (bind al2 (Math|Float|Clamp(Float) (/ (- t 1.6) 1.6) 0.0 1.0))
        (bind sm2 (* (* al2 al2) (- 3.0 (* 2.0 al2))))
        (bind cp2 (Math|Vector|Lerp(Vector) (Math|Vector|MakeVector :X -10200 :Y 10150 :Z 650) (Math|Vector|MakeVector :X -9100 :Y 9950 :Z 1350) sm2))
        (Transformation|SetActorLocationAndRotation :self cam :NewLocation cp2 :NewRotation (Math|Rotator|FindLookatRotation cp2 (Math|Vector|MakeVector :X -6200 :Y 13050 :Z 150)) :bSweep false :bTeleport true)
        (bind pawn2 (Player|GetOwningPlayerPawn))
        (Utilities|IsValid pawn2
          (:"Is Valid"
            (Input|DisableInput :self pawn2 :PlayerController (Widget|GetOwningPlayer))
            (bind mv2 (Actor|GetComponentbyClass :self pawn2 :ComponentClass "/Script/ChaosVehicles.ChaosVehicleMovementComponent"))
            (Game|Components|ChaosVehicleMovement|SetThrottleInput :self mv2 :Throttle 0.0)
            (Game|Components|ChaosVehicleMovement|SetHandbrakeInput :self mv2 :bNewHandbrake true))
          (:"Is Not Valid"))
        (elif (< t 4.8)
          (Variables|Default|SetLamp0 "(R=0.07,G=0.07,B=0.08,A=1)")
          (Variables|Default|SetGlow0 "(R=0.03,G=0.03,B=0.035,A=1)")
          (Variables|Default|SetLamp1 "(R=0.07,G=0.07,B=0.08,A=1)")
          (Variables|Default|SetGlow1 "(R=0.03,G=0.03,B=0.035,A=1)")
          (Variables|Default|SetLamp2 "(R=0.1,G=1,B=0.2,A=1)")
          (Variables|Default|SetGlow2 "(R=0.035,G=0.35,B=0.07,A=1)")
          (Variables|Default|SetLabel "1")
          (Variables|Default|SetLabelColor "(R=0.1,G=1,B=0.2,A=1)")
          (Variables|Default|SetLabelX -19)
          (for lamp1 (Variables|Default|GetLamps)
            (bind lc1 (Actor|GetComponentbyClass :self lamp1 :ComponentClass "/Script/Engine.PointLightComponent"))
            (Rendering|Components|Light|SetLightColor :self lc1 :NewLightColor "(R=0.1,G=1,B=0.15,A=1)" :bSRGB true))
          (if (< (Variables|Default|GetStage) 3)
            (Variables|Default|SetStage 3)
            (Camera|SetFieldOfView :self ccomp :InFieldOfView 36)
            (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_CountHit.SW_RG_CountHit" :VolumeMultiplier 1)
            (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_EngineRev.SW_RG_EngineRev" :VolumeMultiplier 0.9)
            (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_Riser.SW_RG_Riser" :VolumeMultiplier 0.6)
          )
          (bind al1 (Math|Float|Clamp(Float) (/ (- t 3.2) 1.6) 0.0 1.0))
          (bind sm1 (* (* al1 al1) (- 3.0 (* 2.0 al1))))
          (bind cp1 (Math|Vector|Lerp(Vector) (Math|Vector|MakeVector :X -2600 :Y 12560 :Z 125) (Math|Vector|MakeVector :X -3300 :Y 12520 :Z 105) sm1))
          (Transformation|SetActorLocationAndRotation :self cam :NewLocation cp1 :NewRotation (Math|Rotator|FindLookatRotation cp1 (Math|Vector|MakeVector :X -6200 :Y 12900 :Z 70)) :bSweep false :bTeleport true)
          (bind pawn1 (Player|GetOwningPlayerPawn))
          (Utilities|IsValid pawn1
            (:"Is Valid"
              (Input|DisableInput :self pawn1 :PlayerController (Widget|GetOwningPlayer))
              (bind mv1 (Actor|GetComponentbyClass :self pawn1 :ComponentClass "/Script/ChaosVehicles.ChaosVehicleMovementComponent"))
              (Game|Components|ChaosVehicleMovement|SetThrottleInput :self mv1 :Throttle 0.0)
              (Game|Components|ChaosVehicleMovement|SetHandbrakeInput :self mv1 :bNewHandbrake true))
            (:"Is Not Valid"))
          (else
            (Variables|Default|SetLamp0 "(R=0.1,G=1,B=0.2,A=1)")
            (Variables|Default|SetGlow0 "(R=0.035,G=0.35,B=0.07,A=1)")
            (Variables|Default|SetLamp1 "(R=0.1,G=1,B=0.2,A=1)")
            (Variables|Default|SetGlow1 "(R=0.035,G=0.35,B=0.07,A=1)")
            (Variables|Default|SetLamp2 "(R=0.1,G=1,B=0.2,A=1)")
            (Variables|Default|SetGlow2 "(R=0.035,G=0.35,B=0.07,A=1)")
            (Variables|Default|SetLabel "GO!")
            (Variables|Default|SetLabelColor "(R=0.1,G=1,B=0.2,A=1)")
            (Variables|Default|SetLabelX -58)
            (for lampG (Variables|Default|GetLamps)
              (bind lcG (Actor|GetComponentbyClass :self lampG :ComponentClass "/Script/Engine.PointLightComponent"))
              (Rendering|Components|Light|SetLightColor :self lcG :NewLightColor "(R=0.1,G=1,B=0.15,A=1)" :bSRGB true))
            (if (< (Variables|Default|GetStage) 4)
              (Variables|Default|SetStage 4)
              (Variables|Default|SetRacing true)
              (Variables|Default|SetSwoopFrom (Transformation|GetActorLocation :self cam))
              (Development|PrintString :InString (Utilities|String|Append "RG_INTRO GO at server time " (Utilities|String|ToString(Float) now)) :bPrintToScreen false :bPrintToLog true)
              (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_GoHit.SW_RG_GoHit" :VolumeMultiplier 1)
              (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_Whoosh.SW_RG_Whoosh" :VolumeMultiplier 0.8)
              (Audio|PlaySound2D :Sound "/Game/RacingGame/Audio/SW_RG_EngineLaunch.SW_RG_EngineLaunch" :VolumeMultiplier 0.9)
              (bind pawnG (Player|GetOwningPlayerPawn))
              (Utilities|IsValid pawnG
                (:"Is Valid"
                  (Input|EnableInput :self pawnG :PlayerController (Widget|GetOwningPlayer))
                  (bind mvG (Actor|GetComponentbyClass :self pawnG :ComponentClass "/Script/ChaosVehicles.ChaosVehicleMovementComponent"))
                  (Game|Components|ChaosVehicleMovement|SetThrottleInput :self mvG :Throttle 0.0)
                  (Game|Components|ChaosVehicleMovement|SetHandbrakeInput :self mvG :bNewHandbrake false))
                (:"Is Not Valid"))
            )
            (bind gt (- t 4.8))
            (Variables|Default|SetRaceTime gt)
            (Variables|Default|SetLetterbox (Math|Float|Clamp(Float) (- 1.0 (/ gt 0.9)) 0.0 1.0))
            (bind mins (Math|Float|Truncate (/ gt 60.0)))
            (bind secs (- gt (* mins 60.0)))
            (Variables|Default|SetTimerText (Utilities|String|Append "TIME  " (Utilities|String|Append (Utilities|String|Append (Utilities|String|ToString(Integer) mins) ":") (Utilities|String|ToString(Text) (Utilities|Text|ToText(Float) secs :bUseGrouping false :MinimumIntegralDigits 2 :MinimumFractionalDigits 2 :MaximumFractionalDigits 2)))))
            (if (< gt 0.75)
              (bind pawnS (Player|GetOwningPlayerPawn))
              (Utilities|IsValid pawnS
                (:"Is Valid"
                  (for cc (Actor|GetComponentsByClass :self pawnS :ComponentClass "/Script/Engine.CameraComponent")
                    (if (Components|Activation|IsActive :self cc)
                      (Variables|Default|SetHandoffCam (Utilities|Casting|CastToCameraComponent cc))))
                  (bind hc (Variables|Default|GetHandoffCam))
                  (bind sa (Math|Float|Clamp(Float) (/ gt 0.75) 0.0 1.0))
                  (bind ss (* (* sa sa) (- 3.0 (* 2.0 sa))))
                  (bind arc (Math|Trig|Sin(Degrees) (* ss 180.0)))
                  (bind hr (Transformation|GetWorldRotation :self hc))
                  (bind swp (+ (Math|Vector|Lerp(Vector) (Variables|Default|GetSwoopFrom) (Transformation|GetWorldLocation :self hc) ss) (+ (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z (* arc 800)) (* (Transformation|GetActorRightVector :self pawnS) (* arc 600)))))
                  (bind aim (Math|Rotator|FindLookatRotation swp (+ (Transformation|GetActorLocation :self pawnS) (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 60.0))))
                  (Transformation|SetActorLocationAndRotation :self cam :NewLocation swp :NewRotation (Math|Rotator|Lerp(Rotator) aim hr (Math|Float|Clamp(Float) (/ (- ss 0.85) 0.15) 0.0 1.0) true) :bSweep false :bTeleport true)
                  (Camera|SetFieldOfView :self ccomp :InFieldOfView (Math|Float|Lerp 36 (Class|CameraComponent|GetFieldOfView hc) ss)))
                (:"Is Not Valid"))
              (else
                (if (< (Variables|Default|GetStage) 5)
                  (Variables|Default|SetStage 5)
                  (bind pawnB (Player|GetOwningPlayerPawn))
                  (Utilities|IsValid pawnB
                    (:"Is Valid"
                      (Game|Player|SetViewTargetwithBlend :self pc :NewViewTarget pawnB :BlendTime 0.6 :BlendFunc "VTBlend_EaseInOut" :BlendExp 2.0))
                    (:"Is Not Valid"))
                )
                (if (> gt 1.8)
                  (Variables|Default|SetShowLights false))))
          ))))))
