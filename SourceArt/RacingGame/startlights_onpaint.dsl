(fn OnPaint (Context)
  (bind pxs (Variables|Default|GetPixelScale))
  (bind org (Variables|Default|GetOrigin))
  (bind ox (.x org))
  (bind oy (.y org))
  (bind scr (Variables|Default|GetScreenSize))
  (bind bar (* (* (.y scr) 0.12) (Variables|Default|GetLetterbox)))
  (if (> bar 0.5)
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D 0.0 (* bar 0.5)) (Math|Vector2D|MakeVector2D (.x scr) (* bar 0.5)) "(R=0,G=0,B=0,A=1)" false (* pxs bar))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D 0.0 (- (.y scr) (* bar 0.5))) (Math|Vector2D|MakeVector2D (.x scr) (- (.y scr) (* bar 0.5))) "(R=0,G=0,B=0,A=1)" false (* pxs bar)))
  (if (Variables|Default|GetRacing)
    (bind ttx (Utilities|Text|ToText(String) (Variables|Default|GetTimerText)))
    (Painting|DrawText Context ttx (Math|Vector2D|MakeVector2D (- ox 148.0) 16.0) "/Engine/EngineFonts/Roboto.Roboto" 40 "Bold" "(R=0,G=0,B=0,A=0.7)")
    (Painting|DrawText Context ttx (Math|Vector2D|MakeVector2D (- ox 150.0) 13.0) "/Engine/EngineFonts/Roboto.Roboto" 40 "Bold" "(R=1,G=1,B=1,A=1)"))
  (if (Variables|Default|GetShowLights)
  (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ ox -107) (+ oy 0)) (Math|Vector2D|MakeVector2D (+ ox 107) (+ oy 0)) "(R=0.6,G=0.6,B=0.62,A=1)" true (* pxs 124))
  (for k1 (range 41)
    (bind y1 (- (* (+ k1 0.5) 3.02439) 62))
    (bind hw1 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3844 (* y1 y1)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox -107) hw1) (+ (+ oy 0) y1)) (Math|Vector2D|MakeVector2D (+ (+ ox -107) hw1) (+ (+ oy 0) y1)) "(R=0.6,G=0.6,B=0.62,A=1)" true (* pxs 3.62439)))
  (for k2 (range 41)
    (bind y2 (- (* (+ k2 0.5) 3.02439) 62))
    (bind hw2 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3844 (* y2 y2)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 107) hw2) (+ (+ oy 0) y2)) (Math|Vector2D|MakeVector2D (+ (+ ox 107) hw2) (+ (+ oy 0) y2)) "(R=0.6,G=0.6,B=0.62,A=1)" true (* pxs 3.62439)))
  (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ ox -107) (+ oy 0)) (Math|Vector2D|MakeVector2D (+ ox 107) (+ oy 0)) "(R=0.03,G=0.03,B=0.035,A=1)" true (* pxs 116))
  (for k3 (range 38)
    (bind y3 (- (* (+ k3 0.5) 3.05263) 58))
    (bind hw3 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3364 (* y3 y3)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox -107) hw3) (+ (+ oy 0) y3)) (Math|Vector2D|MakeVector2D (+ (+ ox -107) hw3) (+ (+ oy 0) y3)) "(R=0.03,G=0.03,B=0.035,A=1)" true (* pxs 3.65263)))
  (for k4 (range 38)
    (bind y4 (- (* (+ k4 0.5) 3.05263) 58))
    (bind hw4 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3364 (* y4 y4)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 107) hw4) (+ (+ oy 0) y4)) (Math|Vector2D|MakeVector2D (+ (+ ox 107) hw4) (+ (+ oy 0) y4)) "(R=0.03,G=0.03,B=0.035,A=1)" true (* pxs 3.65263)))
  (for k5 (range 37)
    (bind y5 (- (* (+ k5 0.5) 3.02703) 56))
    (bind hw5 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3136 (* y5 y5)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox -104) hw5) (+ (+ oy 0) y5)) (Math|Vector2D|MakeVector2D (+ (+ ox -104) hw5) (+ (+ oy 0) y5)) (Variables|Default|GetGlow0) true (* pxs 3.62703)))
  (for k6 (range 30)
    (bind y6 (- (* (+ k6 0.5) 3.06667) 46))
    (bind hw6 (Math|Float|Sqrt (Math|Float|Max(Float) (- 2116 (* y6 y6)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox -104) hw6) (+ (+ oy 0) y6)) (Math|Vector2D|MakeVector2D (+ (+ ox -104) hw6) (+ (+ oy 0) y6)) "(R=0,G=0,B=0,A=1)" true (* pxs 3.66667)))
  (for k7 (range 25)
    (bind y7 (- (* (+ k7 0.5) 3.04) 38))
    (bind hw7 (Math|Float|Sqrt (Math|Float|Max(Float) (- 1444 (* y7 y7)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox -104) hw7) (+ (+ oy 0) y7)) (Math|Vector2D|MakeVector2D (+ (+ ox -104) hw7) (+ (+ oy 0) y7)) (Variables|Default|GetLamp0) true (* pxs 3.64)))
  (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ ox -120) (- oy 18.0)) (Math|Vector2D|MakeVector2D (+ ox -110) (- oy 23.0)) "(R=1,G=1,B=1,A=0.35)" true (* pxs 6.0))
  (for k8 (range 37)
    (bind y8 (- (* (+ k8 0.5) 3.02703) 56))
    (bind hw8 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3136 (* y8 y8)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 0) hw8) (+ (+ oy 0) y8)) (Math|Vector2D|MakeVector2D (+ (+ ox 0) hw8) (+ (+ oy 0) y8)) (Variables|Default|GetGlow1) true (* pxs 3.62703)))
  (for k9 (range 30)
    (bind y9 (- (* (+ k9 0.5) 3.06667) 46))
    (bind hw9 (Math|Float|Sqrt (Math|Float|Max(Float) (- 2116 (* y9 y9)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 0) hw9) (+ (+ oy 0) y9)) (Math|Vector2D|MakeVector2D (+ (+ ox 0) hw9) (+ (+ oy 0) y9)) "(R=0,G=0,B=0,A=1)" true (* pxs 3.66667)))
  (for k10 (range 25)
    (bind y10 (- (* (+ k10 0.5) 3.04) 38))
    (bind hw10 (Math|Float|Sqrt (Math|Float|Max(Float) (- 1444 (* y10 y10)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 0) hw10) (+ (+ oy 0) y10)) (Math|Vector2D|MakeVector2D (+ (+ ox 0) hw10) (+ (+ oy 0) y10)) (Variables|Default|GetLamp1) true (* pxs 3.64)))
  (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ ox -16) (- oy 18.0)) (Math|Vector2D|MakeVector2D (+ ox -6) (- oy 23.0)) "(R=1,G=1,B=1,A=0.35)" true (* pxs 6.0))
  (for k11 (range 37)
    (bind y11 (- (* (+ k11 0.5) 3.02703) 56))
    (bind hw11 (Math|Float|Sqrt (Math|Float|Max(Float) (- 3136 (* y11 y11)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 104) hw11) (+ (+ oy 0) y11)) (Math|Vector2D|MakeVector2D (+ (+ ox 104) hw11) (+ (+ oy 0) y11)) (Variables|Default|GetGlow2) true (* pxs 3.62703)))
  (for k12 (range 30)
    (bind y12 (- (* (+ k12 0.5) 3.06667) 46))
    (bind hw12 (Math|Float|Sqrt (Math|Float|Max(Float) (- 2116 (* y12 y12)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 104) hw12) (+ (+ oy 0) y12)) (Math|Vector2D|MakeVector2D (+ (+ ox 104) hw12) (+ (+ oy 0) y12)) "(R=0,G=0,B=0,A=1)" true (* pxs 3.66667)))
  (for k13 (range 25)
    (bind y13 (- (* (+ k13 0.5) 3.04) 38))
    (bind hw13 (Math|Float|Sqrt (Math|Float|Max(Float) (- 1444 (* y13 y13)) 0.0)))
    (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (- (+ ox 104) hw13) (+ (+ oy 0) y13)) (Math|Vector2D|MakeVector2D (+ (+ ox 104) hw13) (+ (+ oy 0) y13)) (Variables|Default|GetLamp2) true (* pxs 3.64)))
  (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ ox 88) (- oy 18.0)) (Math|Vector2D|MakeVector2D (+ ox 98) (- oy 23.0)) "(R=1,G=1,B=1,A=0.35)" true (* pxs 6.0))
  (bind lx (+ ox (Variables|Default|GetLabelX)))
  (bind txt (Utilities|Text|ToText(String) (Variables|Default|GetLabel)))
  (Painting|DrawText Context txt (Math|Vector2D|MakeVector2D (+ lx 3.0) (+ oy 76)) "/Engine/EngineFonts/Roboto.Roboto" 64 "Bold" "(R=0,G=0,B=0,A=0.7)")
  (Painting|DrawText Context txt (Math|Vector2D|MakeVector2D lx (+ oy 72)) "/Engine/EngineFonts/Roboto.Roboto" 64 "Bold" (Variables|Default|GetLabelColor))))
