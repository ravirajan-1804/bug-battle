(fn SpawnBots ()
  (bind allm (Actor|GetAllActorsOfClass "/Game/RacingGame/Gameplay/BP_RG_RaceManager.BP_RG_RaceManager_C"))
  (if (and (not (Variables|Default|GetBotsSpawned)) (== (Utilities|Array|Get(acopy) allm 0) self))
    (Variables|Default|SetBotsSpawned true)
    (Utilities|Array|Clear (Variables|Default|GetBots))
    (bind b0 (Game|SpawnActorfromClass :Class "/Game/RacingGame/Vehicles/BeeRacer/BP_RGC_BeeRacer.BP_RGC_BeeRacer_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -6016.5 :Y 13549.9 :Z 100.0) :Rotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -0.383)) :CollisionHandlingOverride "AlwaysSpawn"))
    (Utilities|Array|Add (Variables|Default|GetBots) b0)
    (Pawn|SpawnDefaultController b0)
    (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs (Class|WheeledVehiclePawn|GetVehicleMovementComponent b0) false)
    (Game|AddComponentbyClass :self b0 :Class "/Game/RacingGame/Gameplay/BPC_RG_RacerAI.BPC_RG_RacerAI_C")
    (bind b1 (Game|SpawnActorfromClass :Class "/Game/RacingGame/Vehicles/AntRacer/BP_RGC_AntRacer.BP_RGC_AntRacer_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -6523.8 :Y 12433.1 :Z 100.0) :Rotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -0.363)) :CollisionHandlingOverride "AlwaysSpawn"))
    (Utilities|Array|Add (Variables|Default|GetBots) b1)
    (Pawn|SpawnDefaultController b1)
    (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs (Class|WheeledVehiclePawn|GetVehicleMovementComponent b1) false)
    (Game|AddComponentbyClass :self b1 :Class "/Game/RacingGame/Gameplay/BPC_RG_RacerAI.BPC_RG_RacerAI_C")
    (bind b2 (Game|SpawnActorfromClass :Class "/Game/RacingGame/Vehicles/SnailRacer/BP_RGC_SnailRacer.BP_RGC_SnailRacer_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -7017.0 :Y 13556.2 :Z 100.0) :Rotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -0.334)) :CollisionHandlingOverride "AlwaysSpawn"))
    (Utilities|Array|Add (Variables|Default|GetBots) b2)
    (Pawn|SpawnDefaultController b2)
    (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs (Class|WheeledVehiclePawn|GetVehicleMovementComponent b2) false)
    (Game|AddComponentbyClass :self b2 :Class "/Game/RacingGame/Gameplay/BPC_RG_RacerAI.BPC_RG_RacerAI_C")
    (bind b3 (Game|SpawnActorfromClass :Class "/Game/RacingGame/Vehicles/Beetle/BP_RGC_Beetle.BP_RGC_Beetle_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -7523.2 :Y 12438.9 :Z 100.0) :Rotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -0.294)) :CollisionHandlingOverride "AlwaysSpawn"))
    (Utilities|Array|Add (Variables|Default|GetBots) b3)
    (Pawn|SpawnDefaultController b3)
    (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs (Class|WheeledVehiclePawn|GetVehicleMovementComponent b3) false)
    (Game|AddComponentbyClass :self b3 :Class "/Game/RacingGame/Gameplay/BPC_RG_RacerAI.BPC_RG_RacerAI_C")
    (bind b4 (Game|SpawnActorfromClass :Class "/Game/RacingGame/Vehicles/Butterfly/BP_RGC_Butterfly.BP_RGC_Butterfly_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -8017.9 :Y 13561.3 :Z 100.0) :Rotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -0.243)) :CollisionHandlingOverride "AlwaysSpawn"))
    (Utilities|Array|Add (Variables|Default|GetBots) b4)
    (Pawn|SpawnDefaultController b4)
    (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs (Class|WheeledVehiclePawn|GetVehicleMovementComponent b4) false)
    (Game|AddComponentbyClass :self b4 :Class "/Game/RacingGame/Gameplay/BPC_RG_RacerAI.BPC_RG_RacerAI_C")))
