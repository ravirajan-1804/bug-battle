(fn UpdateRace ()
  (bind pts (Variables|Default|GetTrackPts))
  (bind n (Utilities|Array|Length pts))
  (bind st (Variables|Default|GetIntroStart))
  (Variables|Default|SetRaceT (- (- (GameState|GetServerWorldTimeSeconds (Game|GetGameState)) st) 4.80))
  (Utilities|Array|Clear (Variables|Default|GetCars))
  (for b (Variables|Default|GetBots)
    (Utilities|Array|Add (Variables|Default|GetCars) b))
  (for p (Class|GameStateBase|GetPlayerArray (Game|GetGameState))
    (Utilities|Array|Add (Variables|Default|GetCars) (PlayerState|GetPawn p)))
  (bind nc (Utilities|Array|Length (Variables|Default|GetCars)))
  (Utilities|Array|Resize (Variables|Default|GetLaps) nc)
  (Utilities|Array|Resize (Variables|Default|GetLastRel) nc)
  (Utilities|Array|Resize (Variables|Default|GetLastIdx) nc)
  (Utilities|Array|Resize (Variables|Default|GetSeen) nc)
  (Utilities|Array|Resize (Variables|Default|GetFinishT) nc)
  (Utilities|Array|Resize (Variables|Default|GetFinishOrd) nc)
  (Utilities|Array|Resize (Variables|Default|GetScore) nc)
  (Utilities|Array|Resize (Variables|Default|GetRank) nc)
  (Utilities|Array|Resize (Variables|Default|GetOrder) nc)
  (for s (range nc)
    (bind car (Utilities|Array|Get(acopy) (Variables|Default|GetCars) s))
    (Utilities|IsValid car
      (:"Is Valid"
        (bind loc (Transformation|GetActorLocation :self car))
        (Variables|Default|SetRBestD 1000000000000000.0)
        (if (Utilities|Array|Get(acopy) (Variables|Default|GetSeen) s)
          (for ka (range 0 16)
            (bind ja (Math|Integer|%(Integer) (+ (+ (Utilities|Array|Get(acopy) (Variables|Default|GetLastIdx) s) ka) (- n 4)) n))
            (bind da (Math|Vector|Distance2DSquared(Vector) loc (Utilities|Array|Get(acopy) pts ja)))
            (if (< da (Variables|Default|GetRBestD))
              (Variables|Default|SetRBestD da)
              (Variables|Default|SetRBestI ja))))
        (if (> (Variables|Default|GetRBestD) 4000000.0)
          (Variables|Default|SetRBestD 1000000000000000.0)
          (for kb (range n)
            (bind jb kb)
            (bind db (Math|Vector|Distance2DSquared(Vector) loc (Utilities|Array|Get(acopy) pts jb)))
            (if (< db (Variables|Default|GetRBestD))
              (Variables|Default|SetRBestD db)
              (Variables|Default|SetRBestI jb))))
        (bind idx (Variables|Default|GetRBestI))
        (Utilities|Array|SetArrayElem (Variables|Default|GetLastIdx) s idx true)
        (bind rel (Math|Integer|%(Integer) (+ (- idx (Variables|Default|GetStartI)) n) n))
        (if (not (Utilities|Array|Get(acopy) (Variables|Default|GetSeen) s))
          (Utilities|Array|SetArrayElem (Variables|Default|GetSeen) s true true)
          (Utilities|Array|SetArrayElem (Variables|Default|GetLastRel) s rel true))
        (bind lr (Utilities|Array|Get(acopy) (Variables|Default|GetLastRel) s))
        (if (<= (Utilities|Array|Get(acopy) (Variables|Default|GetFinishT) s) 0.0)
          (if (and (> (* lr 5) (* n 4)) (< (* rel 5) n))
            (Utilities|Array|SetArrayElem (Variables|Default|GetLaps) s (+ (Utilities|Array|Get(acopy) (Variables|Default|GetLaps) s) 1) true)
            (Development|PrintString :InString (Utilities|String|Append "RG_LAP slot " (Utilities|String|Append (Utilities|String|ToString(Integer) s) (Utilities|String|Append " laps " (Utilities|String|ToString(Integer) (Utilities|Array|Get(acopy) (Variables|Default|GetLaps) s))))) :bPrintToScreen false :bPrintToLog true)
            (if (and (> (Utilities|Array|Get(acopy) (Variables|Default|GetLaps) s) (Variables|Default|GetNumLaps)) (> (Variables|Default|GetRaceT) 0.0))
              (Variables|Default|SetFinishCount (+ (Variables|Default|GetFinishCount) 1))
              (Utilities|Array|SetArrayElem (Variables|Default|GetFinishT) s (Variables|Default|GetRaceT) true)
              (Utilities|Array|SetArrayElem (Variables|Default|GetFinishOrd) s (Variables|Default|GetFinishCount) true)
              (Development|PrintString :InString (Utilities|String|Append "RG_FINISH slot " (Utilities|String|ToString(Integer) s)) :bPrintToScreen false :bPrintToLog true)
              (if (and (< s (Utilities|Array|Length (Variables|Default|GetBots))) (Networking|HasAuthority))
                (Actor|DestroyActor (Pawn|GetController car))
                (Actor|DestroyActor car)))
            (elif (and (< (* lr 5) n) (> (* rel 5) (* n 4)))
              (Utilities|Array|SetArrayElem (Variables|Default|GetLaps) s (- (Utilities|Array|Get(acopy) (Variables|Default|GetLaps) s) 1) true))))
        (Utilities|Array|SetArrayElem (Variables|Default|GetLastRel) s rel true)
        (if (> (Utilities|Array|Get(acopy) (Variables|Default|GetFinishT) s) 0.0)
          (Utilities|Array|SetArrayElem (Variables|Default|GetScore) s (- 1000000000.0 (* (Math|Conversions|ToFloat(Integer) (Utilities|Array|Get(acopy) (Variables|Default|GetFinishOrd) s)) 1000000.0)) true)
          (else
            (Utilities|Array|SetArrayElem (Variables|Default|GetScore) s (Math|Conversions|ToFloat(Integer) (+ (* (Utilities|Array|Get(acopy) (Variables|Default|GetLaps) s) n) rel)) true))))
      (:"Is Not Valid")))
  (for s (range nc)
    (Variables|Default|SetRBestI 1)
    (bind sc (Utilities|Array|Get(acopy) (Variables|Default|GetScore) s))
    (for j (range nc)
      (bind sj (Utilities|Array|Get(acopy) (Variables|Default|GetScore) j))
      (if (or (> sj sc) (and (== sj sc) (< j s)))
        (Variables|Default|SetRBestI (+ (Variables|Default|GetRBestI) 1))))
    (Utilities|Array|SetArrayElem (Variables|Default|GetRank) s (Variables|Default|GetRBestI) true))
  (for s (range nc)
    (Utilities|Array|SetArrayElem (Variables|Default|GetOrder) (- (Utilities|Array|Get(acopy) (Variables|Default|GetRank) s) 1) s true)))
