(fn InitMap ()
  (bind tp (Class|BPRGRaceManager|GetTrackPts (Variables|Default|GetRaceMgr)))
  (bind n (Utilities|Array|Length tp))
  (if (> n 20)
    (Utilities|Array|Clear (Variables|Default|GetWorldPts))
    (Variables|Default|SetMinW (Math|Vector2D|MakeVector2D 1000000000000.0 1000000000000.0))
    (Variables|Default|SetMaxW (Math|Vector2D|MakeVector2D -1000000000000.0 -1000000000000.0))
    (for i (range n)
      (if (== (Math|Integer|%(Integer) i 2) 0)
        (bind p (Utilities|Array|Get(acopy) tp i))
        (Utilities|Array|Add (Variables|Default|GetWorldPts) (Math|Vector2D|MakeVector2D (.x p) (.y p)))
        (bind mn (Variables|Default|GetMinW))
        (Variables|Default|SetMinW (Math|Vector2D|MakeVector2D (Math|Float|Min(Float) (.x mn) (.x p)) (Math|Float|Min(Float) (.y mn) (.y p))))
        (bind mx (Variables|Default|GetMaxW))
        (Variables|Default|SetMaxW (Math|Vector2D|MakeVector2D (Math|Float|Max(Float) (.x mx) (.x p)) (Math|Float|Max(Float) (.y mx) (.y p))))))
    (bind mn2 (Variables|Default|GetMinW))
    (bind mx2 (Variables|Default|GetMaxW))
    (Variables|Default|SetWorldC (Math|Vector2D|MakeVector2D (* 0.5 (+ (.x mn2) (.x mx2))) (* 0.5 (+ (.y mn2) (.y mx2)))))
    (Variables|Default|SetNPts (Utilities|Array|Length (Variables|Default|GetWorldPts)))
    (Variables|Default|SetBestD 0.0)
    (bind wc (Variables|Default|GetWorldC))
    (for i (range (Variables|Default|GetNPts))
      (bind w1 (Utilities|Array|Get(acopy) (Variables|Default|GetWorldPts) i))
      (bind ax (- (.x w1) (.x wc)))
      (bind ay (- (.y w1) (.y wc)))
      (bind d1 (+ (* ax ax) (* ay ay)))
      (if (> d1 (Variables|Default|GetBestD))
        (Variables|Default|SetBestD d1)))
    (Variables|Default|SetMapScale (/ 120.0 (+ (Math|Float|Sqrt (Math|Float|Max(Float) (Variables|Default|GetBestD) 1.0)) 1400.0)))
    (Variables|Default|SetBestD 1000000000000000.0)
    (for i (range (Variables|Default|GetNPts))
      (bind w2 (Utilities|Array|Get(acopy) (Variables|Default|GetWorldPts) i))
      (bind bx (- (.x w2) -5020.21))
      (bind by (- (.y w2) 12983))
      (bind d2 (+ (* bx bx) (* by by)))
      (if (< d2 (Variables|Default|GetBestD))
        (Variables|Default|SetBestD d2)
        (Variables|Default|SetStartI i)))
    (Variables|Default|SetMapU (Math|Vector2D|MakeVector2D 0.999976 -0.00695037))
    (Variables|Default|SetArmed false)
    (Variables|Default|SetMapInit true)))
