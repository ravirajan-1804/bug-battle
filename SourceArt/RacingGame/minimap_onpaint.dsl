          (Painting|DrawLine Context tipA fb1A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fa2A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fb2A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fa3A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fb3A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fa4A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fb4A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fa5A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA fb5A pcA true (* pxs 2.4))
          (Painting|DrawLine Context tipA blA "(R=1,G=1,B=1,A=1)" true (* pxs 1.4))
          (Painting|DrawLine Context blA ntA "(R=1,G=1,B=1,A=1)" true (* pxs 1.4))
          (Painting|DrawLine Context ntA brA "(R=1,G=1,B=1,A=1)" true (* pxs 1.4))
          (Painting|DrawLine Context brA tipA "(R=1,G=1,B=1,A=1)" true (* pxs 1.4))
          )
        (:"Is Not Valid"
          (bind pcB (Utilities|Array|Get(acopy) colors 0))
          (bind hrB (* 12.5 (+ 1.0 (* 0.12 (Math|Trig|Sin(Degrees) (* (Utilities|Time|GetRealTimeSeconds) 250.0))))))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrB 1.0000)) (+ py (* hrB 0.0000))) (Math|Vector2D|MakeVector2D (+ px (* hrB 0.9239)) (+ py (* hrB 0.3827))) pcB true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrB 0.9239)) (+ py (* hrB 0.3827))) (Math|Vector2D|MakeVector2D (+ px (* hrB 0.7071)) (+ py (* hrB 0.7071))) pcB true (* pxs 1.6))
