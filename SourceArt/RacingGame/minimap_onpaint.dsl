          (bind fb5A (Math|Vector2D|MakeVector2D (+ px (- (* fx -3.25) (* fy -1.25))) (+ py (+ (* fy -3.25) (* fx -1.25)))))
          (Painting|DrawLine Context tipA blA "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 4.5))
