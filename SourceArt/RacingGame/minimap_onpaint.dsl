(fn OnPaint (Context)
  (bind pxs (Variables|Default|GetPixelScale))
  (Painting|DrawLines Context (Variables|Default|GetTrackShadow) "(R=0,G=0,B=0,A=0.32)" true (* pxs 14))
  (Painting|DrawLines Context (Variables|Default|GetTrackPoints) "(R=0.015,G=0.015,B=0.02,A=0.95)" true (* pxs 11))
  (Painting|DrawLines Context (Variables|Default|GetTrackPoints) "(R=0.95,G=0.96,B=0.97,A=1)" true (* pxs 7))
  (Painting|DrawLine Context "(X=116.08,Y=191.42)" "(X=116.16,Y=203.42)" "(R=1,G=1,B=1,A=1)" true (* pxs 4.8))
  (Painting|DrawLine Context "(X=114.88,Y=191.43)" "(X=114.89,Y=193.83)" "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 2.4))
  (Painting|DrawLine Context "(X=117.29,Y=193.81)" "(X=117.31,Y=196.21)" "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 2.4))
  (Painting|DrawLine Context "(X=114.91,Y=196.23)" "(X=114.93,Y=198.63)" "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 2.4))
  (Painting|DrawLine Context "(X=117.33,Y=198.61)" "(X=117.35,Y=201.01)" "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 2.4))
  (Painting|DrawLine Context "(X=114.95,Y=201.03)" "(X=114.96,Y=203.43)" "(R=0.015,G=0.015,B=0.02,A=1)" true (* pxs 2.4))
  (Painting|DrawLine Context "(X=123.72,Y=194.22)" "(X=127.12,Y=197.42)" "(R=1,G=0.05,B=0.35,A=1)" true (* pxs 1.8))
  (Painting|DrawLine Context "(X=127.12,Y=197.42)" "(X=123.72,Y=200.62)" "(R=1,G=0.05,B=0.35,A=1)" true (* pxs 1.8))
  (if (Variables|Default|GetSpeedoReady)
    (bind po (Variables|Default|GetPaintOff))
    (bind sc (Variables|Default|GetSpeedoC))
    (bind gc (Variables|Default|GetGearC))
    (bind scx (- (.x sc) (.x po)))
    (bind scy (- (.y sc) (.y po)))
    (bind gcx (- (+ (.x gc) -4) (.x po)))
    (bind gcy (- (+ (.y gc) 6) (.y po)))
    (bind ss (Variables|Default|GetSpeedStr))
    (Painting|DrawText Context (Utilities|Text|ToText(String) ss) (Math|Vector2D|MakeVector2D (+ (- scx (* (Utilities|String|Len ss) 15.680)) 1.5) (+ (- scy 38.032) 2.0)) "/Engine/EngineFonts/Roboto.Roboto" 42 "Bold Italic" "(R=0,G=0,B=0,A=0.6)")
    (Painting|DrawText Context (Utilities|Text|ToText(String) ss) (Math|Vector2D|MakeVector2D (- scx (* (Utilities|String|Len ss) 15.680)) (- scy 38.032)) "/Engine/EngineFonts/Roboto.Roboto" 42 "Bold Italic" "(R=1,G=1,B=1,A=1)")
    (bind us (Variables|Default|GetUnitStr))
    (Painting|DrawText Context (Utilities|Text|ToText(String) us) (Math|Vector2D|MakeVector2D (- scx (* (Utilities|String|Len us) 5.280)) (+ scy 22.0)) "/Engine/EngineFonts/Roboto.Roboto" 12 "Bold" "(R=1,G=0.05,B=0.35,A=1)")
    (bind gs (Variables|Default|GetGearStr))
    (Painting|DrawText Context (Utilities|Text|ToText(String) gs) (Math|Vector2D|MakeVector2D (+ (- gcx (* (Utilities|String|Len gs) 12.400)) 1.5) (+ (- gcy 22.880) 2.0)) "/Engine/EngineFonts/Roboto.Roboto" 30 "Bold Italic" "(R=0,G=0,B=0,A=0.6)")
    (Painting|DrawText Context (Utilities|Text|ToText(String) gs) (Math|Vector2D|MakeVector2D (- gcx (* (Utilities|String|Len gs) 12.400)) (- gcy 22.880)) "/Engine/EngineFonts/Roboto.Roboto" 30 "Bold Italic" "(R=1,G=1,B=1,A=1)")
    (Painting|DrawText Context (Utilities|Text|ToText(String) "GEAR") (Math|Vector2D|MakeVector2D (- gcx 17.600) (+ gcy 44.0)) "/Engine/EngineFonts/Roboto.Roboto" 10 "Bold" "(R=1,G=1,B=1,A=0.65)"))
  (bind scale (Variables|Default|GetMapScale))
  (bind off (Variables|Default|GetMapOffset))
  (bind colors (Variables|Default|GetRacerColors))
  (bind me (Player|GetOwningPlayerPawn))
  (bind cars (Actor|GetAllActorsOfClass "/Script/ChaosVehicles.WheeledVehiclePawn"))
  (for i (range (Utilities|Array|Length cars))
    (bind car (Utilities|Array|Get(acopy) cars i))
    (if (!= car me)
      (bind ps (Class|Pawn|GetPlayerState car))
      (Utilities|IsValid ps
        (:"Is Valid"
          (bind locA (Transformation|GetActorLocation :self car))
          (bind mxA (+ (* (.x locA) scale) (.x off)))
          (bind myA (+ (* (.y locA) scale) (.y off)))
          (bind rcA (Utilities|Array|Get(acopy) colors (Math|Integer|%(Integer) (Class|PlayerState|GetPlayerId ps) 7)))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 3.300) (+ myA 0.000)) (Math|Vector2D|MakeVector2D (+ mxA 2.333) (+ myA 2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 2.333) (+ myA 2.333)) (Math|Vector2D|MakeVector2D (+ mxA 0.000) (+ myA 3.300)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 0.000) (+ myA 3.300)) (Math|Vector2D|MakeVector2D (+ mxA -2.333) (+ myA 2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -2.333) (+ myA 2.333)) (Math|Vector2D|MakeVector2D (+ mxA -3.300) (+ myA 0.000)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -3.300) (+ myA 0.000)) (Math|Vector2D|MakeVector2D (+ mxA -2.333) (+ myA -2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -2.333) (+ myA -2.333)) (Math|Vector2D|MakeVector2D (+ mxA -0.000) (+ myA -3.300)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -0.000) (+ myA -3.300)) (Math|Vector2D|MakeVector2D (+ mxA 2.333) (+ myA -2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 2.333) (+ myA -2.333)) (Math|Vector2D|MakeVector2D (+ mxA 3.300) (+ myA -0.000)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 2.500) (+ myA 0.000)) (Math|Vector2D|MakeVector2D (+ mxA 1.768) (+ myA 1.768)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 1.768) (+ myA 1.768)) (Math|Vector2D|MakeVector2D (+ mxA 0.000) (+ myA 2.500)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 0.000) (+ myA 2.500)) (Math|Vector2D|MakeVector2D (+ mxA -1.768) (+ myA 1.768)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -1.768) (+ myA 1.768)) (Math|Vector2D|MakeVector2D (+ mxA -2.500) (+ myA 0.000)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -2.500) (+ myA 0.000)) (Math|Vector2D|MakeVector2D (+ mxA -1.768) (+ myA -1.768)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -1.768) (+ myA -1.768)) (Math|Vector2D|MakeVector2D (+ mxA -0.000) (+ myA -2.500)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA -0.000) (+ myA -2.500)) (Math|Vector2D|MakeVector2D (+ mxA 1.768) (+ myA -1.768)) rcA true (* pxs 5))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxA 1.768) (+ myA -1.768)) (Math|Vector2D|MakeVector2D (+ mxA 2.500) (+ myA -0.000)) rcA true (* pxs 5))
          )
        (:"Is Not Valid"
          (Utilities|IsValid (Pawn|GetController car)
            (:"Is Valid"
              (bind locB (Transformation|GetActorLocation :self car))
              (bind mxB (+ (* (.x locB) scale) (.x off)))
              (bind myB (+ (* (.y locB) scale) (.y off)))
              (bind rcB (Utilities|Array|Get(acopy) colors (Math|Integer|%(Integer) i 7)))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 3.300) (+ myB 0.000)) (Math|Vector2D|MakeVector2D (+ mxB 2.333) (+ myB 2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 2.333) (+ myB 2.333)) (Math|Vector2D|MakeVector2D (+ mxB 0.000) (+ myB 3.300)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 0.000) (+ myB 3.300)) (Math|Vector2D|MakeVector2D (+ mxB -2.333) (+ myB 2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -2.333) (+ myB 2.333)) (Math|Vector2D|MakeVector2D (+ mxB -3.300) (+ myB 0.000)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -3.300) (+ myB 0.000)) (Math|Vector2D|MakeVector2D (+ mxB -2.333) (+ myB -2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -2.333) (+ myB -2.333)) (Math|Vector2D|MakeVector2D (+ mxB -0.000) (+ myB -3.300)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -0.000) (+ myB -3.300)) (Math|Vector2D|MakeVector2D (+ mxB 2.333) (+ myB -2.333)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 2.333) (+ myB -2.333)) (Math|Vector2D|MakeVector2D (+ mxB 3.300) (+ myB -0.000)) "(R=1,G=1,B=1,A=1)" true (* pxs 6.6))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 2.500) (+ myB 0.000)) (Math|Vector2D|MakeVector2D (+ mxB 1.768) (+ myB 1.768)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 1.768) (+ myB 1.768)) (Math|Vector2D|MakeVector2D (+ mxB 0.000) (+ myB 2.500)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 0.000) (+ myB 2.500)) (Math|Vector2D|MakeVector2D (+ mxB -1.768) (+ myB 1.768)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -1.768) (+ myB 1.768)) (Math|Vector2D|MakeVector2D (+ mxB -2.500) (+ myB 0.000)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -2.500) (+ myB 0.000)) (Math|Vector2D|MakeVector2D (+ mxB -1.768) (+ myB -1.768)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -1.768) (+ myB -1.768)) (Math|Vector2D|MakeVector2D (+ mxB -0.000) (+ myB -2.500)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB -0.000) (+ myB -2.500)) (Math|Vector2D|MakeVector2D (+ mxB 1.768) (+ myB -1.768)) rcB true (* pxs 5))
              (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ mxB 1.768) (+ myB -1.768)) (Math|Vector2D|MakeVector2D (+ mxB 2.500) (+ myB -0.000)) rcB true (* pxs 5))
              )
            (:"Is Not Valid"))))))
  (Utilities|IsValid me
    (:"Is Valid"
      (bind ploc (Transformation|GetActorLocation :self me))
      (bind px (+ (* (.x ploc) scale) (.x off)))
      (bind py (+ (* (.y ploc) scale) (.y off)))
      (bind fwd (Transformation|GetActorForwardVector :self me))
      (bind fx (.x fwd))
      (bind fy (.y fwd))
      (bind mps (Class|Pawn|GetPlayerState me))
      (Utilities|IsValid mps
        (:"Is Valid"
          (bind pcA (Utilities|Array|Get(acopy) colors (Math|Integer|%(Integer) (Class|PlayerState|GetPlayerId mps) 7)))
          (bind hrA (* 12.5 (+ 1.0 (* 0.12 (Math|Trig|Sin(Degrees) (* (Utilities|Time|GetRealTimeSeconds) 250.0))))))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 1.0000)) (+ py (* hrA 0.0000))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.9239)) (+ py (* hrA 0.3827))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.9239)) (+ py (* hrA 0.3827))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.7071)) (+ py (* hrA 0.7071))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.7071)) (+ py (* hrA 0.7071))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.3827)) (+ py (* hrA 0.9239))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.3827)) (+ py (* hrA 0.9239))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.0000)) (+ py (* hrA 1.0000))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.0000)) (+ py (* hrA 1.0000))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.3827)) (+ py (* hrA 0.9239))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.3827)) (+ py (* hrA 0.9239))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.7071)) (+ py (* hrA 0.7071))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.7071)) (+ py (* hrA 0.7071))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.9239)) (+ py (* hrA 0.3827))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.9239)) (+ py (* hrA 0.3827))) (Math|Vector2D|MakeVector2D (+ px (* hrA -1.0000)) (+ py (* hrA 0.0000))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -1.0000)) (+ py (* hrA 0.0000))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.9239)) (+ py (* hrA -0.3827))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.9239)) (+ py (* hrA -0.3827))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.7071)) (+ py (* hrA -0.7071))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.7071)) (+ py (* hrA -0.7071))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.3827)) (+ py (* hrA -0.9239))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.3827)) (+ py (* hrA -0.9239))) (Math|Vector2D|MakeVector2D (+ px (* hrA -0.0000)) (+ py (* hrA -1.0000))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA -0.0000)) (+ py (* hrA -1.0000))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.3827)) (+ py (* hrA -0.9239))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.3827)) (+ py (* hrA -0.9239))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.7071)) (+ py (* hrA -0.7071))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.7071)) (+ py (* hrA -0.7071))) (Math|Vector2D|MakeVector2D (+ px (* hrA 0.9239)) (+ py (* hrA -0.3827))) pcA true (* pxs 1.6))
          (Painting|DrawLine Context (Math|Vector2D|MakeVector2D (+ px (* hrA 0.9239)) (+ py (* hrA -0.3827))) (Math|Vector2D|MakeVector2D (+ px (* hrA 1.0000)) (+ py (* hrA -0.0000))) pcA true (* pxs 1.6))
          (bind tipA (Math|Vector2D|MakeVector2D (+ px (- (* fx 13) (* fy 0))) (+ py (+ (* fy 13) (* fx 0)))))
          (bind blA (Math|Vector2D|MakeVector2D (+ px (- (* fx -7) (* fy 7.5))) (+ py (+ (* fy -7) (* fx 7.5)))))
          (bind ntA (Math|Vector2D|MakeVector2D (+ px (- (* fx -2.5) (* fy 0))) (+ py (+ (* fy -2.5) (* fx 0)))))
          (bind brA (Math|Vector2D|MakeVector2D (+ px (- (* fx -7) (* fy -7.5))) (+ py (+ (* fy -7) (* fx -7.5)))))
          (bind fa1A (Math|Vector2D|MakeVector2D (+ px (- (* fx -6.25) (* fy 6.25))) (+ py (+ (* fy -6.25) (* fx 6.25)))))
          (bind fb1A (Math|Vector2D|MakeVector2D (+ px (- (* fx -6.25) (* fy -6.25))) (+ py (+ (* fy -6.25) (* fx -6.25)))))
          (bind fa2A (Math|Vector2D|MakeVector2D (+ px (- (* fx -5.5) (* fy 5))) (+ py (+ (* fy -5.5) (* fx 5)))))
          (bind fb2A (Math|Vector2D|MakeVector2D (+ px (- (* fx -5.5) (* fy -5))) (+ py (+ (* fy -5.5) (* fx -5)))))
          (bind fa3A (Math|Vector2D|MakeVector2D (+ px (- (* fx -4.75) (* fy 3.75))) (+ py (+ (* fy -4.75) (* fx 3.75)))))
          (bind fb3A (Math|Vector2D|MakeVector2D (+ px (- (* fx -4.75) (* fy -3.75))) (+ py (+ (* fy -4.75) (* fx -3.75)))))
